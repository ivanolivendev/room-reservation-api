        "text": "{\n  \"name\": \"Sala Treinamento 01\",\n  \"type\": \"MEETING_ROOM\",\n  \"capacity\": 20\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ]
    },
